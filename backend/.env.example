NODE_ENV="development"
PORT=8000
DATABASE_URL="postgresql://user:password@localhost:5432/dbname"

# Authentication Secrets
JWT_SECRET="your_jwt_secret_key"
JWT_ACCESS_EXPIRES_IN="1h"
JWT_REFRESH_EXPIRES_IN="7d"

BETTER_AUTH_SECRET="your_better_auth_secret_key"
BETTER_AUTH_BASE_URL="http://localhost:8000"

# Client/Frontend URL
CLIENT_URL="http://localhost:3000"
PROD_APP_URL="https://your-production-app-url.com"

# Email Configuration (SMTP)
EMAIL_SENDER_SMTP_HOST="smtp.example.com"
EMAIL_SENDER_SMTP_PORT="465"
EMAIL_SENDER_SMTP_USER="your_email@example.com"
EMAIL_SENDER_SMTP_PASS="your_email_password"
EMAIL_SENDER_SMTP_FROM="your_email@example.com"

# Cloudinary Configuration (Image Uploads)
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# Google OAuth
GOOGLE_CLIENT_ID="your_google_client_id"
GOOGLE_CLIENT_SECRET="your_google_client_secret"
